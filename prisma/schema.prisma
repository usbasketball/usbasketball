generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  FORMER
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  team           String?
  status         UserStatus @default(ACTIVE)
  joinedAt       DateTime   @default(now())
  deregisteredAt DateTime?

  @@map("users")
}

model InterestSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  birthDate DateTime
  position  String
  interest  String
  gender    String
  lastLevel String?
  lastSeason String?
  background String?
  locale    String   @default("nl")
  createdAt DateTime @default(now())

  @@index([email])
  @@map("interest_submissions")
}
