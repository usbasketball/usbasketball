# Prisma / PostgreSQL (Neon)
# Copy this file to .env and fill in your real values.
DATABASE_URL="postgresql://user:password@localhost:5432/usbasketballnl?schema=public"

# Auth0 (authentication)
# Create a "Regular Web Application" in the Auth0 dashboard and fill in its
# domain, client ID and client secret below.
AUTH0_DOMAIN="your-tenant.eu.auth0.com"
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
# 32-byte secret used to encrypt session cookies. Generate with: openssl rand -hex 32
AUTH0_SECRET=""
# Base URL of this app. In the Auth0 application settings register:
#   - "<APP_BASE_URL>/auth/callback" under Allowed Callback URLs
#   - "<APP_BASE_URL>", plus the locale variants used as logout returnTo
#     (e.g. "<APP_BASE_URL>/en" and "<APP_BASE_URL>/nl"), under Allowed Logout URLs
# Optional locally (inferred from the request host); set it explicitly in production.
APP_BASE_URL="http://localhost:3000"

# Public site config
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="US Basketbal"
NEXT_PUBLIC_CONTACT_EMAIL="info@usbasketballnl.example"
NEXT_PUBLIC_SECRETARIAT_EMAIL="secretaris@usbasketball.nl"
NEXT_PUBLIC_TC_EMAIL="tc@usbasketball.nl"

# Bestuur GraphQL API
# URL of the bestuur app's GraphQL endpoint, used to fetch the current user's
# NBB number (and future member data) on the /me page. The request forwards the
# Auth0 session cookie so bestuur can resolve the caller's own user.
BESTUUR_GRAPHQL_URL=""

# Resend (transactional email)
# From address must be a verified sender in your Resend account (domain or shared).
RESEND_API_KEY="re_xxx"
EMAIL_FROM="US Basketball <onboarding@resend.dev>"

# Cloudflare Turnstile (interest form bot protection)
# Site key is public (rendered in the page). Secret key comes from the widget in the
# Cloudflare dashboard — never commit it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAEMR50iFgh2CcH0Q"
TURNSTILE_SECRET=""
# Comma-separated hostnames that may render the widget (no localhost in production).
TURNSTILE_HOSTNAMES="localhost"

# Contentful (training schedule + ALV notes)
# Generate an access token under Settings > API keys in the Contentful dashboard.
CONTENTFUL_SPACE_ID=""
CONTENTFUL_ENVIRONMENT="master"
CONTENTFUL_ACCESS_TOKEN=""
# Shared secret for the /api/revalidate webhook. Configure a Contentful webhook
# on "Entry publish" events that POSTs to <SITE_URL>/api/revalidate with this
# value in the "x-webhook-secret" header so the schedule refreshes instantly.
CONTENTFUL_WEBHOOK_SECRET=""

# Sentry (error monitoring & tracing)
# Auth token for source-map uploads. Never commit this value.
# Set in Vercel for Production + Preview builds.
SENTRY_AUTH_TOKEN=""

# Private registration page (/register, Foys form)
# Secret used to sign expiring access links. Generate with: openssl rand -hex 32
REGISTRATION_SECRET=""
# The Foys form configuration identifier (the {{identifier}} in the embed snippet).
FOYS_REGISTRATION_FORM_NL_ID=""
# Same for the English form (falls back to FOYS_REGISTRATION_FORM_NL_ID if unset).
FOYS_REGISTRATION_FORM_EN_ID=""
